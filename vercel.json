{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run typecheck",
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/mcp/:secret",
      "destination": "/api/mcp?secret=:secret"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ]
}
