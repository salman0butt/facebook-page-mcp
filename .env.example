# Facebook Page
FB_PAGE_ID=123456789012345
FB_PAGE_ACCESS_TOKEN=EAAB...

# Current Graph API major version as of 2026-08-13.
FB_GRAPH_API_VERSION=v26.0

# Optional. Set this if your Meta app enables "Require App Secret" / appsecret_proof.
FB_APP_SECRET=
FB_REQUEST_TIMEOUT_MS=20000

# MCP server
# Local development should bind loopback.
HOST=127.0.0.1
PORT=3000

# If HOST is 0.0.0.0 or another non-loopback bind, this is REQUIRED.
# Hostnames only; no scheme or port. Example: mcp.example.com
MCP_ALLOWED_HOSTS=

# Optional Origin-host allowlist. If omitted on a public bind, MCP_ALLOWED_HOSTS is reused.
# Hostnames only; no scheme or port.
MCP_ALLOWED_ORIGINS=

# Personal-MVP route protection. Endpoint:
# https://your-domain.example/mcp/<this-secret>
# Generate with: openssl rand -hex 32
# For a shared/production ChatGPT integration, use OAuth 2.1 rather than relying on this alone.
MCP_ROUTE_SECRET=replace-with-a-long-random-secret-value

# Keep true until you intentionally want real Facebook writes.
# facebook_get_page_info is still a real read so credentials can be verified.
DRY_RUN=true
